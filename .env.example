# Variables the service reads; copy to .env (never versioned) and fill in.
# Address the server listens on inside the container
LISTEN_ADDR=:8080
# Base URLs of the two participants (HTTP, inside the platform network).
CASH_REPORTING_BASE_URL=http://cash-reporting-api:8085
COMMERCIAL_RESERVATION_BASE_URL=http://commercial-reservation-api:8083
# issued by multi-tour-security (`security issue-service-token workflow-register-payment <duration>`), never versioned
SERVICE_TOKEN=
# public key of the security service, to check the caller's JWT: a file, or the PEM text in JWT_PUBLIC_KEY
JWT_PUBLIC_KEY_FILE=<path-to-public-key>
# connection as workflow_register_payment_app
DATABASE_URL=postgres://workflow_register_payment_app:<password>@postgres:5432/<database>
# Step timing (ADR-004 D10): timeout per attempt, 1s to 30s; attempts per step, 1 to 5
STEP_TIMEOUT=5s
STEP_ATTEMPTS=3
